# ── Backend Environment Variables ─────────────────────────────
# Copy this file to `.env` and fill in the values.
# NEVER commit the real .env file.

# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/erp_crm_db?schema=public

# JWT
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Bcrypt
BCRYPT_SALT_ROUNDS=12
